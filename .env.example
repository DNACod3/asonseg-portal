# =========================================================================
# ASONSEG Portal — TEMPLATE de variáveis de ambiente para DEV LOCAL
# Uso: `cp .env.example .env.local` + `supabase start` — já funciona, sem editar.
# (Backend local = Supabase CLI; ver ADR-0016 e supabase/config.toml.)
# Toda variável abaixo é validada por src/shared/env.ts (build falha se faltar).
# Para STAGING/PROD, preencher com segredos reais (NÃO commitar — .gitignore cobre .env.*).
# =========================================================================

# Ambiente
NODE_ENV=development
LOG_LEVEL=debug

# --- Banco de dados (Supabase CLI local; prod: Supabase Pooler) -------------
# Stack local via `supabase start` — Postgres na porta 55322 (supabase/config.toml).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Em produção (Supabase): DATABASE_URL usa o Transaction Pooler (porta 6543,
# ?pgbouncer=true) e DIRECT_URL o Session Pooler (porta 5432, IPv4).

# --- Supabase Auth + Storage (CLI local — `supabase start`) -----------------
# API/Auth/Storage em http://127.0.0.1:55321 | Studio: :55323 | Mailpit: :55324
# Chaves locais são fixas/públicas (demo do CLI, iguais em qualquer máquina).
# Reextrair a qualquer momento com `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- E-mail (local: Mailpit via Supabase; prod: Resend) ---------------------
RESEND_API_KEY=re_dummy_key
EMAIL_FROM=nao-responda@asonseg.org.br
# E-mails de Auth (confirmação/reset) caem no Mailpit: http://127.0.0.1:55324

# --- Observabilidade (Sentry) — DSN opcional em dev -------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- CAPTCHA (Cloudflare Turnstile) -----------------------------------------
# Chaves de teste públicas do Turnstile (sempre passam) — trocar em produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- LLM (Anthropic) — extração de CV ---------------------------------------
# Dummy só faz o boot passar; para exercitar extração de CV, usar chave real.
ANTHROPIC_API_KEY=sk-ant-dummy-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Backup duplo (Backblaze B2) --------------------------------------------
B2_KEY_ID=dummy-key-id
B2_APPLICATION_KEY=dummy-application-key
B2_BUCKET=asonseg-backups-dev

# --- Autenticação (USP-004) -------------------------------------------------
# Retenção de tentativas de login (email + IP) para anti-brute-force/DoS.
# Pendente validação LGPD da DPO (DEC-012); 90d é proposta inicial.
AUTH_ATTEMPTS_RETENTION_DAYS=90
# Feature flag de bloqueio do login (ex.: manutenção / rollback emergencial).
AUTH_LOGIN_ENABLED=true
