# =========================================================================
# ASONSEG Portal — exemplo de variáveis de ambiente
# Copie para .env.local e preencha. NUNCA coloque segredos reais aqui.
# Toda variável abaixo é validada por src/shared/env.ts (build falha se faltar).
# =========================================================================

# Ambiente
NODE_ENV=development
LOG_LEVEL=debug

# --- Banco de dados (local: Docker Compose; prod: Supabase Pooler) ----------
# Local (docker-compose.yml): Postgres em localhost:5432
DATABASE_URL=postgresql://asonseg:asonseg@localhost:5432/asonseg?schema=public
DIRECT_URL=postgresql://asonseg:asonseg@localhost:5432/asonseg?schema=public
# Em produção (Supabase): DATABASE_URL usa o Transaction Pooler (porta 6543,
# ?pgbouncer=true) e DIRECT_URL a conexão direta (porta 5432).

# --- Supabase Auth + Storage (projeto dev) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# --- E-mail (local: MailHog; prod: Resend) ----------------------------------
RESEND_API_KEY=re_dummy_key
EMAIL_FROM=nao-responda@asonseg.org.br
# MailHog local: SMTP em localhost:1025, UI em http://localhost:8025

# --- Observabilidade (Sentry) — DSN opcional em dev -------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- CAPTCHA (Cloudflare Turnstile) -----------------------------------------
# Chaves de teste públicas do Turnstile (sempre passam) — trocar em produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- LLM (Anthropic) — extração de CV ---------------------------------------
ANTHROPIC_API_KEY=sk-ant-dummy-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Backup duplo (Backblaze B2) --------------------------------------------
B2_KEY_ID=dummy-key-id
B2_APPLICATION_KEY=dummy-application-key
B2_BUCKET=asonseg-backups-dev
