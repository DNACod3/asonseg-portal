// Prisma schema — ASONSEG Portal
// Datasource dual-URL (ADR-T-0002): aplicação usa o Pooler (PgBouncer) via DATABASE_URL;
// migrations usam a conexão direta via DIRECT_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Tabela de infraestrutura para smoke de conectividade (sem domínio).
/// Os modelos de domínio são adicionados por cada módulo nas tasks seguintes.
model HealthCheck {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("_health_check")
}

// ── Taxonomia (US #111) ───────────────────────────────────────────────
// Áreas de vaga, categorias de serviço e regiões atendidas.
// Relações de volta (Job, Service, CandidateProfile, ProviderProfile)
// serão adicionadas pelos respectivos módulos nas tasks seguintes.

/// Área profissional de uma vaga / interesse do candidato.
model JobArea {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  isSuggestion Boolean   @default(false) @map("is_suggestion")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy   String?   @map("approved_by") @db.Uuid
  suggestedBy  String?   @map("suggested_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  candidateProfiles CandidateProfile[]
  jobs              Job[]

  @@map("job_areas")
}

/// Categoria do catálogo de serviços de prestadores.
model ServiceCategory {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  isSuggestion Boolean   @default(false) @map("is_suggestion")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy   String?   @map("approved_by") @db.Uuid
  suggestedBy  String?   @map("suggested_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("service_categories")
}

/// Região (bairro) atendida pelo portal.
model Region {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  cityName  String   @map("city_name")
  state     String   @default("SC")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  providerProfiles  ProviderProfile[]
  jobs              Job[] // USP-021: vagas filtráveis por região
  candidateProfiles CandidateProfile[] // USP-028: localização do candidato na busca ativa

  @@map("regions")
}

/// Item da checklist de verificação de Empresa (USP-017 / F0B-01 / B-004).
/// Dado de referência seedável — sem FK, mesmo padrão de JobArea/ServiceCategory.
/// Substitui a constante TS embutida no bundle (F0-MN-04): trocar o conteúdo
/// dos itens passa a ser um seed/UPDATE, não um redeploy. Conteúdo definitivo
/// é gate de go-live (sponsor + coordenador + PO); o seed inicial usa
/// docs/operacao/checklist-empresa-fantasma.md (critérios A/B).
model VerificationChecklistItem {
  id         String   @id @default(uuid()) @db.Uuid
  /// Código estável do critério ('A1', 'B2', ...) — chave de upsert idempotente.
  code       String   @unique
  /// Seção do checklist: 'A' eliminatório | 'B' presença | 'C' red-flag.
  section    String
  label      String
  /// "Como verificar" (docs/operacao/checklist-empresa-fantasma.md).
  guidance   String?
  /// Eliminatório: qualquer item bloqueante reprovado → rejeitar.
  isBlocking Boolean  @default(false) @map("is_blocking")
  order      Int
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("verification_checklist_items")
}

// ── Identity / Auth (USP-001, USP-004) ───────────────────────────────────────
// Pessoa = entidade fundamental (ADR-0011). Papéis compostos via PersonRoleGrant.
// Credencial gerenciada pelo Supabase Auth (bcrypt cost 10); vínculo via
// supabase_user_id. Consentimentos LGPD registrados na tabela consents.

/// Status operacional da Pessoa. Revalidado a cada request (ADR-0030)
/// para fechar a janela de "sessão zumbi" após USP-007 (inativação).
enum PersonStatus {
  ATIVO
  INATIVO

  @@map("person_status")
}

/// Papéis disponíveis no portal (ADR-0011).
enum Role {
  CANDIDATE
  PROVIDER
  CLIENT
  COMPANY_RESPONSIBLE
  VOLUNTEER
  COORDINATOR
  SOCIAL_ASSISTANT
  BOARD
  BENEFICIARY // Release 2
  FAMILY_RESPONSIBLE // Release 2

  @@map("role")
}

/// Status de um grant de papel — o papel só fica ACTIVE após o
/// consentimento da finalidade ser persistido (ADR-0013 / ADR-0020).
enum RoleGrantStatus {
  ACTIVE
  REVOKED
  AWAITING_CONSENT
  INACTIVE

  @@map("role_grant_status")
}

/// Finalidades de consentimento LGPD (ADR-0013).
enum ConsentPurpose {
  PORTAL_ACCESS
  JOB_APPLICATION
  SERVICE_OFFERING
  SERVICE_HIRING
  COMPANY_REPRESENTATION
  SOCIAL_ASSISTANCE
  CV_AI_EXTRACTION
  SOCIAL_REFERRAL_TO_JOB

  @@map("consent_purpose")
}

/// Meio de verificação de identidade de uma reivindicação de credencial (USP-003).
/// D-011 resolveu o processo como confirmação manual pela AS via canal seguro; os
/// demais valores ficam disponíveis para quando o processo escrito incluir carta/presencial.
enum CredentialVerificationMethod {
  IN_PERSON
  AS_CONFIRMATION
  CODE_BY_MAIL

  @@map("credential_verification_method")
}

/// Ciclo de vida de uma reivindicação de credencial (USP-003 / IDN-07, IDN-08).
enum CredentialClaimStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("credential_claim_status")
}

/// Pessoa = entidade fundamental do domínio (ADR-0011).
/// CPF e e-mail únicos por Pessoa; CPF nullable apenas quando a AS cria
/// exceção documental via USP-002 (P-007 das expectations).
model Person {
  id                        String       @id @default(uuid()) @db.Uuid
  status                    PersonStatus @default(ATIVO)
  /// Vínculo com a credencial Supabase Auth (nullable: Pessoas sem credencial criadas pela AS).
  supabaseUserId            String?      @unique @map("supabase_user_id") @db.Uuid
  fullName                  String       @map("full_name")
  /// CPF único. Nullable apenas via USP-002 (cpf_exception_justification obrigatória nesses casos).
  cpf                       String?      @unique
  cpfExceptionJustification String?      @map("cpf_exception_justification")
  /// E-mail canônico (lowercase + trim). Unique constraint garante P-001 (ADR-0021).
  emailLogin                String?      @unique @map("email_login")
  phone                     String?
  birthDate                 DateTime?    @map("birth_date") @db.Date
  fullAddress               String?      @map("full_address")
  mustChangePassword        Boolean      @default(false) @map("must_change_password")
  inactivatedAt             DateTime?    @map("inactivated_at") @db.Timestamptz(6)
  inactivatedByPersonId     String?      @map("inactivated_by_person_id") @db.Uuid
  inactivationReason        String?      @map("inactivation_reason")
  createdByPersonId         String?      @map("created_by_person_id") @db.Uuid
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential           Credential?
  roleGrants           PersonRoleGrant[]
  consents             Consent[]
  credentialClaims     CredentialClaim[]
  delegatedPermissions DelegatedPermission[]
  companyGrants        PersonCompanyGrant[]
  candidateProfile     CandidateProfile?
  providerProfile      ProviderProfile?
  clientProfile        ClientProfile?
  authoredJobs         Job[]
  applications         Application[]

  @@map("persons")
}

/// Vínculo Pessoa ↔ credencial Supabase Auth.
/// O hash bcrypt é gerenciado pelo Supabase Auth (cost 10, não configurável).
/// Mantido para o fluxo USP-004 (flag de primeiro acesso / troca de senha).
model Credential {
  id             String   @id @default(uuid()) @db.Uuid
  personId       String   @unique @map("person_id") @db.Uuid
  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  primeiroAcesso Boolean  @default(false) @map("primeiro_acesso")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("credentials")
}

/// Reivindicação de credencial de uma Pessoa pré-cadastrada (USP-003 / IDN-07, IDN-08).
/// A solicitação NÃO cria nova Pessoa: vincula-se à Pessoa que já existe (P-002 / F2).
/// A credencial só é ativada após verificação de identidade confirmada por
/// AS/diretoria (D-011), registrada com o meio utilizado (P-001 / P-005). Convenção
/// append-only: as transições PENDING → VERIFIED/REJECTED atualizam `status`, não deletam.
model CredentialClaim {
  id                 String                       @id @default(uuid()) @db.Uuid
  personId           String                       @map("person_id") @db.Uuid
  /// E-mail desejado para a credencial (lowercase + trim). Unicidade validada na action (E-003).
  requestedEmail     String                       @map("requested_email")
  /// Meio de verificação solicitado e, ao confirmar, efetivamente utilizado (D-011).
  verificationMethod CredentialVerificationMethod @map("verification_method")
  status             CredentialClaimStatus        @default(PENDING)
  /// Pessoa (AS/diretoria) que confirmou a verificação (P-005). Nulo enquanto PENDING.
  verifiedByPersonId String?                      @map("verified_by_person_id") @db.Uuid
  verifiedAt         DateTime?                    @map("verified_at") @db.Timestamptz(6)
  /// Motivo da rejeição (preenchido apenas quando status = REJECTED).
  rejectedReason     String?                      @map("rejected_reason")
  requestedAt        DateTime                     @default(now()) @map("requested_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  // Fila de verificação: claims PENDING ordenados por chegada (L-004 / SLA ≤ 7 dias).
  @@index([status, requestedAt])
  @@index([personId])
  @@map("credential_claims")
}

/// Grant de papel de uma Pessoa. O papel só chega a ACTIVE quando o consentimento
/// da finalidade correspondente for persistido na MESMA transação (ADR-0020).
model PersonRoleGrant {
  id               String          @id @default(uuid()) @db.Uuid
  personId         String          @map("person_id") @db.Uuid
  role             Role
  status           RoleGrantStatus @default(AWAITING_CONSENT)
  activatedAt      DateTime        @default(now()) @map("activated_at") @db.Timestamptz(6)
  activatedBy      String?         @map("activated_by") @db.Uuid
  revokedAt        DateTime?       @map("revoked_at") @db.Timestamptz(6)
  revokedBy        String?         @map("revoked_by") @db.Uuid
  revocationReason String?         @map("revocation_reason")

  person Person @relation(fields: [personId], references: [id])

  @@unique([personId, role, activatedAt])
  @@index([personId, status])
  @@index([role, status])
  @@map("person_role_grants")
}

/// Catálogo fechado de permissões delegáveis a voluntários (USP-008 / ADR-0001).
/// Namespace `portal:` — nunca misturar com permissões de papel (Role).
enum PermissionId {
  MODERATE_JOB
  MODERATE_CV
  MODERATE_SERVICE
  VALIDATE_COMPANY_FIRST_JOB
  INACTIVATE_PUBLISHED_CONTENT
  REFER_PERSON_TO_JOB
  APPROVE_CATEGORY_SUGGESTION
  REGISTER_REFERRAL_RESULT
  APPROVE_CREDENTIAL_CLAIM

  @@map("permission_id")
}

/// Permissão administrativa delegada pelo coordenador a um voluntário (USP-008).
/// Concessão aplica imediatamente; revogação via revokedAt (efeito no próximo carregamento — ADR-0030).
model DelegatedPermission {
  id         String       @id @default(uuid()) @db.Uuid
  personId   String       @map("person_id") @db.Uuid
  permission PermissionId
  /// Área de escopo (opcional — ex.: "empregabilidade"). Null = sem restrição de área.
  scopeArea  String?      @map("scope_area")
  grantedBy  String       @map("granted_by") @db.Uuid
  grantedAt  DateTime     @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?      @map("revoked_by") @db.Uuid

  person Person @relation(fields: [personId], references: [id])

  @@index([personId, revokedAt])
  @@index([personId, permission, revokedAt])
  @@map("delegated_permissions")
}

/// Registro de consentimento LGPD por finalidade (ADR-0013).
/// Append-only por convenção — revogar insere revokedAt, não deleta.
/// term_content_hash = SHA-256 do texto do termo aceito (evidência LGPD).
model Consent {
  id              String         @id @default(uuid()) @db.Uuid
  personId        String         @map("person_id") @db.Uuid
  purpose         ConsentPurpose
  termVersion     String         @map("term_version")
  termContentHash String         @map("term_content_hash")
  acceptedAt      DateTime       @default(now()) @map("accepted_at") @db.Timestamptz(6)
  acceptedIp      String?        @map("accepted_ip") @db.Inet
  userAgent       String?        @map("user_agent")
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?        @map("revoked_reason")
  context         Json?

  person Person @relation(fields: [personId], references: [id])

  @@unique([personId, purpose, acceptedAt])
  @@index([personId, purpose, revokedAt])
  // Índice único PARCIAL `consents_active_purpose_unique (person_id, purpose)
  // WHERE revoked_at IS NULL` garante no máximo um consentimento ATIVO por
  // finalidade (USP-043 #37). Criado via SQL em migration (não expressável aqui).
  @@map("consents")
}

// ── Empresas (USP-012 — ADR-0015) ────────────────────────────────────────────
// Empresa cadastrada pela Pessoa-responsável. CNPJ único e normalizado (somente
// dígitos). isVerified=false até aprovação da primeira vaga (USP-017).
// PersonCompanyGrant vincula Pessoa↔Empresa com tipo RESPONSIBLE; append-only
// (revogação via revokedAt, nunca delete).

/// Regime tributário da Empresa (ADR-0031). MEI = Microempreendedor Individual;
/// demais valores classificam Empresas com CNPJ regular por regime fiscal.
/// Substitui o par anterior {CNPJ_REGULAR, MEI}: CNPJ_REGULAR → SIMPLES_NACIONAL.
enum CompanyType {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  SA

  @@map("company_type")
}

/// Tipo do vínculo Pessoa↔Empresa.
enum CompanyGrantType {
  RESPONSIBLE

  @@map("company_grant_type")
}

/// Ciclo de status do vínculo Pessoa↔Empresa (USP-013).
/// PENDING = criado por adicionarResponsavel, aguardando aceite explícito (P-002);
/// ACTIVE = aceito (USP-013) ou criado direto no cadastro da Empresa (USP-012).
/// Remoção continua representada por revokedAt != null (append-only, USP-014).
enum CompanyGrantStatus {
  PENDING
  ACTIVE

  @@map("company_grant_status")
}

/// Empresa cadastrada no portal (ADR-0015).
/// CNPJ armazenado apenas com dígitos (normalizado antes de persistir).
model Company {
  id           String      @id @default(uuid()) @db.Uuid
  cnpj         String      @unique
  type         CompanyType @default(SIMPLES_NACIONAL)
  razaoSocial  String      @map("razao_social")
  nomeFantasia String      @map("nome_fantasia")
  setor        String
  descricao    String?
  endereco     String?
  isVerified   Boolean     @default(false) @map("is_verified")
  // USP-017 — verificação na 1ª vaga aprovada (efeito colateral atômico de
  // transitionContent, ADR-0024). `isVerified` É o estado de "1ª vaga" (AD-2):
  // a detecção não conta jobs. Marcação só pelo CompanyVerifyHook (P-005/AD-3).
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6) // E-002 / E-004
  verifiedByPersonId String?   @map("verified_by_person_id") @db.Uuid // E-002 (responsável que aprovou)
  verificationJobId  String?   @map("verification_job_id") @db.Uuid   // E-002 (vaga que disparou)
  verifiedSnapshot   Json?     @map("verified_snapshot")              // L-002 (dados vigentes no instante, P-004)
  rejectionCount     Int       @default(0) @map("rejection_count")    // E-003 / F3 (vagas rejeitadas enquanto não verificada)
  createdBy    String      @map("created_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  grants PersonCompanyGrant[]
  jobs   Job[]

  @@index([cnpj])
  @@map("companies")
}

/// Vínculo Pessoa↔Empresa (append-only). Revogação via revokedAt.
model PersonCompanyGrant {
  id           String           @id @default(uuid()) @db.Uuid
  personId     String           @map("person_id") @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  grantType    CompanyGrantType @default(RESPONSIBLE) @map("grant_type")
  grantedBy    String           @map("granted_by") @db.Uuid
  grantedAt    DateTime         @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?          @map("revoked_by") @db.Uuid
  // USP-014 — motivo de negócio (opcional) da remoção, ao lado de quando/quem (D-014-B).
  // Vive com a entidade (não no audit_log) p/ relatórios desacoplados da auditoria.
  // Grants revogados antes da USP-014 ficam null (sem backfill).
  revokeReason String?          @map("revoke_reason")

  // USP-013 — ciclo pendente→ativo (default ACTIVE cobre grants legados/USP-012).
  status     CompanyGrantStatus @default(ACTIVE) @map("status")
  pendingAt  DateTime?          @map("pending_at") @db.Timestamptz(6)
  acceptedAt DateTime?          @map("accepted_at") @db.Timestamptz(6)

  person  Person  @relation(fields: [personId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([personId, revokedAt])
  @@index([companyId, grantType, revokedAt])
  // UNIQUE parcial (person, company) WHERE revoked_at IS NULL via migration SQL raw
  // (P-004/ADR-0021) — Prisma não expressa índice parcial no schema.
  @@map("person_company_grants")
}

// ── Vagas (USP-020) ──────────────────────────────────────────────────────────
/// Vaga publicada por uma Empresa (USP-020). Conteúdo moderável: nasce em DRAFT
/// e transiciona via `transitionContent()` (ContentKind.JOB). Visibilidade pública
/// (status ACTIVE + validade >= hoje + Empresa verificada) é filtrada on-read na USP-021.
model Job {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @map("company_id") @db.Uuid
  authorPersonId     String        @map("author_person_id") @db.Uuid
  title              String
  // Campos de conteúdo nullable: um RASCUNHO (E-003) pode ser salvo só com título;
  // a completude (L-003) é exigida no SUBMIT pelo Zod (publishJobSchema), não no DB.
  // Mesmo padrão de CandidateProfile (USP-009 — conteúdo opcional, status = moderação).
  areaId             String?       @map("area_id") @db.Uuid
  description        String?       @db.Text
  requirements       String?       @db.Text
  benefits           String?       @db.Text
  salary             String? // freetext legado (USP-020); substituído por salaryMin/Max no filtro de faixa (USP-021)
  workRegime         String?       @map("work_regime") // regime (presencial/remoto/híbrido — string livre no MVP)
  location           String?
  // USP-021 (AD-011): campos canônicos do TD §4.5 que faltavam, p/ os 6 filtros (E-002).
  // Opcionais/com default p/ não quebrar vagas existentes; o JobForm exige no submit via Zod.
  educationLevelRequired String?    @map("education_level_required") // freetext (espelha CandidateProfile.educationLevel)
  contractType           String?    @map("contract_type") // CLT, PJ, MEI… (string livre; enum quando D-007 fechar)
  salaryMin              Decimal?   @map("salary_min") @db.Decimal(10, 2)
  salaryMax              Decimal?   @map("salary_max") @db.Decimal(10, 2)
  salaryVisible          Boolean    @default(true) @map("salary_visible") // edge: false → salário oculto na busca
  regionId               String?    @map("region_id") @db.Uuid // FK Region (opcional no DB; UI exige no submit)
  validUntil         DateTime?     @map("valid_until") @db.Date // validade (date); on-read >= hoje (USP-024)
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?     @map("published_at") @db.Timestamptz(6) // preenchido na 1ª ativação (USP-016)
  // Idempotência do lembrete D-3 (USP-024 / E-003 / U24-MN-07): marcado na 1ª vez que o cron
  // enfileira o aviso de expiração próxima na Outbox; nulo até lá. Sem backfill.
  expiryReminderSentAt DateTime?   @map("expiry_reminder_sent_at") @db.Timestamptz(6)
  lastStatusChangeAt DateTime      @default(now()) @map("last_status_change_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company  @relation(fields: [companyId], references: [id])
  area    JobArea? @relation(fields: [areaId], references: [id])
  author  Person   @relation(fields: [authorPersonId], references: [id])
  region  Region?  @relation(fields: [regionId], references: [id])

  applications Application[]

  // Dedup EXATA (P-003 / ADR-0021): impede 2 vagas idênticas vivas da mesma Empresa.
  // UNIQUE parcial — só estados "vivos" contam — criada via SQL bruto na migration
  // (Prisma não expressa `@@unique` com WHERE). Ver migration `..._usp020_job`.
  @@index([status])
  @@index([companyId])
  @@index([status, validUntil]) // USP-021: filtro on-read (E-001/P-003) — L-001/RP-009
  @@index([areaId, regionId, status]) // USP-021: filtros combinados (E-002)
  @@map("jobs")
}

// ── Candidaturas (USP-022 — AD-012) ──────────────────────────────────────────
/// Candidatura de uma Pessoa (papel candidato) a uma Vaga. Introduzida pela USP-022
/// na forma MÍNIMA capaz apenas de **contar** candidaturas ativas (contador E-003 do
/// detalhe da vaga). O caminho de **escrita** (candidatar/cancelar) é da USP-025/026
/// (AD-017). `cancelledAt = null` ⇒ candidatura ativa (soft-cancel); o índice parcial
/// de contagem `(jobId, cancelledAt)` resolve o contador on-read.
model Application {
  id                String    @id @default(uuid()) @db.Uuid
  candidatePersonId String    @map("candidate_person_id") @db.Uuid
  jobId             String    @map("job_id") @db.Uuid
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6) // null = candidatura ativa (soft-cancel)
  appliedAt         DateTime  @default(now()) @map("applied_at") @db.Timestamptz(6)
  // A-2 (AD-017): `Referral` é Fase 5 (USP-037) e ainda não existe — materializamos só
  // o boolean agora (sempre false na Fase 3). USP-037 adiciona a FK `viaReferralId` e
  // passa a setar este campo, sem re-migrar a coluna.
  viaEncaminhamento Boolean   @default(false) @map("via_encaminhamento")

  candidate Person @relation(fields: [candidatePersonId], references: [id])
  job       Job    @relation(fields: [jobId], references: [id])

  // uq_application_active (SQL bruto nesta migração, Prisma não expressa índice
  // parcial no schema): UNIQUE (candidate_person_id, job_id) WHERE cancelled_at IS
  // NULL — no máx. 1 candidatura ATIVA por (candidato, vaga); permite recandidatura
  // após cancelar (A-3 / AD-017). Supersede o `@@unique([jobId, candidatePersonId,
  // appliedAt])` de technical-design.md §4.5 (não garante unicidade ativa sob corrida).
  @@index([jobId, cancelledAt]) // contagem on-read do contador (E-003)
  @@map("applications")
}

// ── Moderação de conteúdo (USP-016 / ADR-0011) ───────────────────────────────
// Máquina de estados do ciclo de vida de vaga/CV/serviço. A USP-016 é a **owner**
// do enum `ContentStatus` (GAP-2): as USPs de conteúdo (Job/Service/CandidateProfile)
// reusam esta coluna, nunca redeclaram. Histórico de transições vive no `audit_log`
// (append-only, ADR-0008) — não há tabela própria de transições.

/// Estado de moderação de um conteúdo (ADR-0011). `EXPIRED` só se aplica a vaga (JOB).
enum ContentStatus {
  DRAFT
  IN_MODERATION
  AWAITING_ADJUSTMENTS
  ACTIVE
  REJECTED
  PAUSED
  EXPIRED
  ARCHIVED
  INACTIVATED

  @@map("content_status")
}

// ── Persons / Candidato (USP-009) ────────────────────────────────────────────
/// Perfil do papel candidato (1:1 com Person). Conteúdo moderável: nasce em DRAFT
/// e transiciona via `transitionContent()` (módulo moderation, ContentKind.CANDIDATE_PROFILE).
/// Campos `cv*` guardam apenas a estrutura do anexo; o parsing/extração por IA é da USP-040.
model CandidateProfile {
  personId                String        @id @map("person_id") @db.Uuid
  headline                String?
  primaryAreaOfInterestId String?       @map("primary_area_of_interest_id") @db.Uuid
  educationLevel          String?       @map("education_level")
  educationArea           String?       @map("education_area")
  experienceText          String?       @map("experience_text") @db.Text
  skillsText              String?       @map("skills_text") @db.Text
  coursesText             String?       @map("courses_text") @db.Text
  availability            String?
  // USP-028: localização estruturada do candidato (espelha `ProviderProfile.regionId`).
  // Nullable — a coleta no form de cadastro (USP-009) é follow-up fora do escopo;
  // candidatos reais nascem sem região até lá (busca/exibição tratam null com graça).
  regionId                String?       @map("region_id") @db.Uuid
  cvStoragePath           String?       @map("cv_storage_path")
  cvSha256                String?       @map("cv_sha256")
  cvUploadedAt            DateTime?     @map("cv_uploaded_at") @db.Timestamptz(6)
  cvLastConfirmedAt       DateTime?     @map("cv_last_confirmed_at") @db.Timestamptz(6)
  publicationStatus       ContentStatus @default(DRAFT) @map("publication_status")
  lastStatusChangeAt      DateTime      @default(now()) @map("last_status_change_at") @db.Timestamptz(6)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  person                Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  primaryAreaOfInterest JobArea? @relation(fields: [primaryAreaOfInterestId], references: [id])
  region                Region?  @relation(fields: [regionId], references: [id])

  @@index([publicationStatus])
  @@index([regionId])
  @@map("candidate_profiles")
}

/// Perfil do prestador de serviço PF (USP-010 / CAD-06..08, ADR-0031).
/// Ativado imediatamente (papel não é moderado — ADR-0015); a moderação incide
/// sobre o serviço (USP-016/USP-029). **Sem campo de CNPJ**: o CNPJ MEI vive em
/// `companies` via fluxo USP-012 (ADR-0031). Upload da foto difere p/ Fase 4
/// (bucket `provider-photos`); `photo_storage_path` permanece nullable.
model ProviderProfile {
  personId          String        @id @map("person_id") @db.Uuid
  headline          String?
  description       String?       @db.Text
  photoStoragePath  String?       @map("photo_storage_path")
  regionId          String?       @map("region_id") @db.Uuid
  publicationStatus ContentStatus @default(DRAFT) @map("publication_status")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  person Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id])

  @@index([publicationStatus])
  @@map("provider_profiles")
}

/// Perfil leve do cliente de serviço (USP-011 / CAD-09). Ativado automaticamente
/// na 1ª manifestação de interesse (USP-033). Sem moderação/publicationStatus (ADR-0011/0008).
/// cityId é UUID nullable sem FK — não há model City no MVP.
model ClientProfile {
  personId  String   @id @map("person_id") @db.Uuid
  cityId    String?  @map("city_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

/// Store transitório de conteúdo moderável para a máquina de estados (GAP-8).
/// Nenhum model real (`jobs`/`services`/`candidate_profiles`) existe ainda — só
/// `Company` (USP-012). Esta tabela dá um backing store mínimo para
/// `transitionContent` e a fila de moderação (1º tipo a aterrissar — ADR-0011),
/// e lastreia os testes de integração. Segue a convenção `_`-prefix de infra sem
/// domínio (cf. `_health_check`); cada conteúdo real assume seu próprio adapter.
model ModerationFixtureContent {
  id             String        @id @default(uuid()) @db.Uuid
  kind           String
  status         ContentStatus @default(IN_MODERATION)
  title          String
  authorPersonId String        @map("author_person_id") @db.Uuid
  submittedAt    DateTime      @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@index([status, submittedAt])
  @@map("_moderation_fixture")
}

/// Resultado de uma tentativa de autenticação.
enum AuthOutcome {
  SUCCESS
  FAILURE

  @@map("auth_outcome")
}

/// Tentativas de login para lockout `(email, ip)` 5 falhas em 15 min
/// (ADR-0029). Tabela técnica, separada de `audit_log` (ADR-0023).
/// Retenção parametrizada por `AUTH_ATTEMPTS_RETENTION_DAYS` (default 90 dias).
model AuthAttempt {
  id          String      @id @default(uuid()) @db.Uuid
  /// E-mail normalizado (lowercase + trim) — ver normalização em loginAction.
  email       String
  ip          String
  outcome     AuthOutcome
  attemptedAt DateTime    @default(now()) @map("attempted_at") @db.Timestamptz(6)

  @@index([email, ip, attemptedAt], name: "auth_attempts_lockout_idx")
  @@index([attemptedAt], name: "auth_attempts_retention_idx")
  @@map("auth_attempts")
}

// ── Auditoria (US #12 — ADR-0023 / ADR-T-0004) ────────────────────────────
// Log imutável de toda escrita sensível. Append-only garantido no nível do
// banco por `REVOKE UPDATE, DELETE` (ver migration desta tabela). Catálogo de
// eventos em `@/modules/audit/events`; gravação via `withAudit(...)` na mesma
// transação da operação (ADR-0020 — atomicidade: audit falha => rollback).
// Retenção operacional de 1 ano (job mensal de purge — scripts/purge-audit-log.ts).

/// Registro de auditoria append-only (technical-design.md §2.9).
/// `id` é BIGSERIAL para volume contínuo sem colisão de UUID.
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Ator no plano de autenticação (Supabase Auth user). Nullable em eventos
  /// sem ator (ex.: cron de expiração/purge) ou falha de login com e-mail desconhecido.
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  /// Ator no plano de domínio (Pessoa). Nullable pelos mesmos motivos.
  actorPersonId String?  @map("actor_person_id") @db.Uuid
  /// Tipo do evento — vem do catálogo `@/modules/audit/events` (string solta proibida).
  action        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  /// Estado anterior (UPDATE/DELETE) — nulo em INSERT. Nunca inclui senhas/tokens/CV cru.
  before        Json?
  /// Estado posterior (INSERT/UPDATE) — nulo em DELETE.
  after         Json?
  /// Contexto da request: requestId, rota, origem etc. (sem PII).
  context       Json?
  ip            String?  @db.Inet
  userAgent     String?  @map("user_agent")
  /// Obrigatória (validada na app) em revogação/rejeição/edição retroativa.
  justification String?

  @@index([entityType, entityId])
  @@index([actorPersonId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt], name: "audit_log_retention_idx")
  @@map("audit_log")
}

/// Transactional outbox (ADR-0020). Linhas enfileiradas DENTRO da transação de
/// negócio (mesma tx do withAudit), garantindo que a notificação só passa a
/// existir se a operação de negócio commitou (atomicidade). O envio assíncrono
/// real (dispatcher que consome a fila e chama o EmailSender) é da USP-044 —
/// nesta USP-013 apenas enfileiramos a linha. `topic` discrimina o consumidor
/// (ex.: "email"); `payload` carrega a mensagem serializada (ex.: EmailMessage).
model Outbox {
  id          String    @id @default(uuid()) @db.Uuid
  topic       String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([processedAt, createdAt])
  @@map("outbox")
}
