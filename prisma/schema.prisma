// Prisma schema — ASONSEG Portal
// Datasource dual-URL (ADR-T-0002): aplicação usa o Pooler (PgBouncer) via DATABASE_URL;
// migrations usam a conexão direta via DIRECT_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Tabela de infraestrutura para smoke de conectividade (sem domínio).
/// Os modelos de domínio são adicionados por cada módulo nas tasks seguintes.
model HealthCheck {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("_health_check")
}

// ── Taxonomia (US #111) ───────────────────────────────────────────────
// Áreas de vaga, categorias de serviço e regiões atendidas.
// Relações de volta (Job, Service, CandidateProfile, ProviderProfile)
// serão adicionadas pelos respectivos módulos nas tasks seguintes.

/// Área profissional de uma vaga / interesse do candidato.
model JobArea {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  isSuggestion Boolean   @default(false) @map("is_suggestion")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy   String?   @map("approved_by") @db.Uuid
  suggestedBy  String?   @map("suggested_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("job_areas")
}

/// Categoria do catálogo de serviços de prestadores.
model ServiceCategory {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  isSuggestion Boolean   @default(false) @map("is_suggestion")
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedBy   String?   @map("approved_by") @db.Uuid
  suggestedBy  String?   @map("suggested_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("service_categories")
}

/// Região (bairro) atendida pelo portal.
model Region {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  cityName  String   @map("city_name")
  state     String   @default("SC")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("regions")
}

// ── Identity / Auth (USP-001, USP-004) ───────────────────────────────────────
// Pessoa = entidade fundamental (ADR-0011). Papéis compostos via PersonRoleGrant.
// Credencial gerenciada pelo Supabase Auth (bcrypt cost 10); vínculo via
// supabase_user_id. Consentimentos LGPD registrados na tabela consents.

/// Status operacional da Pessoa. Revalidado a cada request (ADR-0030)
/// para fechar a janela de "sessão zumbi" após USP-007 (inativação).
enum PersonStatus {
  ATIVO
  INATIVO

  @@map("person_status")
}

/// Papéis disponíveis no portal (ADR-0011).
enum Role {
  CANDIDATE
  PROVIDER
  CLIENT
  COMPANY_RESPONSIBLE
  VOLUNTEER
  COORDINATOR
  SOCIAL_ASSISTANT
  BOARD
  BENEFICIARY         // Release 2
  FAMILY_RESPONSIBLE  // Release 2

  @@map("role")
}

/// Status de um grant de papel — o papel só fica ACTIVE após o
/// consentimento da finalidade ser persistido (ADR-0013 / ADR-0020).
enum RoleGrantStatus {
  ACTIVE
  REVOKED
  AWAITING_CONSENT
  INACTIVE

  @@map("role_grant_status")
}

/// Finalidades de consentimento LGPD (ADR-0013).
enum ConsentPurpose {
  PORTAL_ACCESS
  JOB_APPLICATION
  SERVICE_OFFERING
  SERVICE_HIRING
  COMPANY_REPRESENTATION
  SOCIAL_ASSISTANCE
  CV_AI_EXTRACTION
  SOCIAL_REFERRAL_TO_JOB

  @@map("consent_purpose")
}

/// Meio de verificação de identidade de uma reivindicação de credencial (USP-003).
/// D-011 resolveu o processo como confirmação manual pela AS via canal seguro; os
/// demais valores ficam disponíveis para quando o processo escrito incluir carta/presencial.
enum CredentialVerificationMethod {
  IN_PERSON
  AS_CONFIRMATION
  CODE_BY_MAIL

  @@map("credential_verification_method")
}

/// Ciclo de vida de uma reivindicação de credencial (USP-003 / IDN-07, IDN-08).
enum CredentialClaimStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("credential_claim_status")
}

/// Pessoa = entidade fundamental do domínio (ADR-0011).
/// CPF e e-mail únicos por Pessoa; CPF nullable apenas quando a AS cria
/// exceção documental via USP-002 (P-007 das expectations).
model Person {
  id                        String       @id @default(uuid()) @db.Uuid
  status                    PersonStatus @default(ATIVO)
  /// Vínculo com a credencial Supabase Auth (nullable: Pessoas sem credencial criadas pela AS).
  supabaseUserId            String?      @unique @map("supabase_user_id") @db.Uuid
  fullName                  String       @map("full_name")
  /// CPF único. Nullable apenas via USP-002 (cpf_exception_justification obrigatória nesses casos).
  cpf                       String?      @unique
  cpfExceptionJustification String?      @map("cpf_exception_justification")
  /// E-mail canônico (lowercase + trim). Unique constraint garante P-001 (ADR-0021).
  emailLogin                String?      @unique @map("email_login")
  phone                     String?
  birthDate                 DateTime?    @map("birth_date") @db.Date
  fullAddress               String?      @map("full_address")
  mustChangePassword        Boolean      @default(false) @map("must_change_password")
  inactivatedAt             DateTime?    @map("inactivated_at") @db.Timestamptz(6)
  inactivatedByPersonId     String?      @map("inactivated_by_person_id") @db.Uuid
  inactivationReason        String?      @map("inactivation_reason")
  createdByPersonId         String?      @map("created_by_person_id") @db.Uuid
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential            Credential?
  roleGrants            PersonRoleGrant[]
  consents              Consent[]
  credentialClaims      CredentialClaim[]
  delegatedPermissions  DelegatedPermission[]
  companyGrants         PersonCompanyGrant[]

  @@map("persons")
}

/// Vínculo Pessoa ↔ credencial Supabase Auth.
/// O hash bcrypt é gerenciado pelo Supabase Auth (cost 10, não configurável).
/// Mantido para o fluxo USP-004 (flag de primeiro acesso / troca de senha).
model Credential {
  id             String   @id @default(uuid()) @db.Uuid
  personId       String   @unique @map("person_id") @db.Uuid
  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  primeiroAcesso Boolean  @default(false) @map("primeiro_acesso")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("credentials")
}

/// Reivindicação de credencial de uma Pessoa pré-cadastrada (USP-003 / IDN-07, IDN-08).
/// A solicitação NÃO cria nova Pessoa: vincula-se à Pessoa que já existe (P-002 / F2).
/// A credencial só é ativada após verificação de identidade confirmada por
/// AS/diretoria (D-011), registrada com o meio utilizado (P-001 / P-005). Convenção
/// append-only: as transições PENDING → VERIFIED/REJECTED atualizam `status`, não deletam.
model CredentialClaim {
  id                 String                       @id @default(uuid()) @db.Uuid
  personId           String                       @map("person_id") @db.Uuid
  /// E-mail desejado para a credencial (lowercase + trim). Unicidade validada na action (E-003).
  requestedEmail     String                       @map("requested_email")
  /// Meio de verificação solicitado e, ao confirmar, efetivamente utilizado (D-011).
  verificationMethod CredentialVerificationMethod @map("verification_method")
  status             CredentialClaimStatus        @default(PENDING)
  /// Pessoa (AS/diretoria) que confirmou a verificação (P-005). Nulo enquanto PENDING.
  verifiedByPersonId String?                      @map("verified_by_person_id") @db.Uuid
  verifiedAt         DateTime?                    @map("verified_at") @db.Timestamptz(6)
  /// Motivo da rejeição (preenchido apenas quando status = REJECTED).
  rejectedReason     String?                      @map("rejected_reason")
  requestedAt        DateTime                     @default(now()) @map("requested_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  // Fila de verificação: claims PENDING ordenados por chegada (L-004 / SLA ≤ 7 dias).
  @@index([status, requestedAt])
  @@index([personId])
  @@map("credential_claims")
}

/// Grant de papel de uma Pessoa. O papel só chega a ACTIVE quando o consentimento
/// da finalidade correspondente for persistido na MESMA transação (ADR-0020).
model PersonRoleGrant {
  id               String          @id @default(uuid()) @db.Uuid
  personId         String          @map("person_id") @db.Uuid
  role             Role
  status           RoleGrantStatus @default(AWAITING_CONSENT)
  activatedAt      DateTime        @default(now()) @map("activated_at") @db.Timestamptz(6)
  activatedBy      String?         @map("activated_by") @db.Uuid
  revokedAt        DateTime?       @map("revoked_at") @db.Timestamptz(6)
  revokedBy        String?         @map("revoked_by") @db.Uuid
  revocationReason String?         @map("revocation_reason")

  person Person @relation(fields: [personId], references: [id])

  @@unique([personId, role, activatedAt])
  @@index([personId, status])
  @@index([role, status])
  @@map("person_role_grants")
}

/// Catálogo fechado de permissões delegáveis a voluntários (USP-008 / ADR-0001).
/// Namespace `portal:` — nunca misturar com permissões de papel (Role).
enum PermissionId {
  MODERATE_JOB
  MODERATE_CV
  MODERATE_SERVICE
  VALIDATE_COMPANY_FIRST_JOB
  INACTIVATE_PUBLISHED_CONTENT
  REFER_PERSON_TO_JOB
  APPROVE_CATEGORY_SUGGESTION
  REGISTER_REFERRAL_RESULT
  APPROVE_CREDENTIAL_CLAIM

  @@map("permission_id")
}

/// Permissão administrativa delegada pelo coordenador a um voluntário (USP-008).
/// Concessão aplica imediatamente; revogação via revokedAt (efeito no próximo carregamento — ADR-0030).
model DelegatedPermission {
  id          String       @id @default(uuid()) @db.Uuid
  personId    String       @map("person_id") @db.Uuid
  permission  PermissionId
  /// Área de escopo (opcional — ex.: "empregabilidade"). Null = sem restrição de área.
  scopeArea   String?      @map("scope_area")
  grantedBy   String       @map("granted_by") @db.Uuid
  grantedAt   DateTime     @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedBy   String?      @map("revoked_by") @db.Uuid

  person Person @relation(fields: [personId], references: [id])

  @@index([personId, revokedAt])
  @@index([personId, permission, revokedAt])
  @@map("delegated_permissions")
}

/// Registro de consentimento LGPD por finalidade (ADR-0013).
/// Append-only por convenção — revogar insere revokedAt, não deleta.
/// term_content_hash = SHA-256 do texto do termo aceito (evidência LGPD).
model Consent {
  id              String         @id @default(uuid()) @db.Uuid
  personId        String         @map("person_id") @db.Uuid
  purpose         ConsentPurpose
  termVersion     String         @map("term_version")
  termContentHash String         @map("term_content_hash")
  acceptedAt      DateTime       @default(now()) @map("accepted_at") @db.Timestamptz(6)
  acceptedIp      String?        @map("accepted_ip") @db.Inet
  userAgent       String?        @map("user_agent")
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedReason   String?        @map("revoked_reason")
  context         Json?

  person Person @relation(fields: [personId], references: [id])

  @@unique([personId, purpose, acceptedAt])
  @@index([personId, purpose, revokedAt])
  // Índice único PARCIAL `consents_active_purpose_unique (person_id, purpose)
  // WHERE revoked_at IS NULL` garante no máximo um consentimento ATIVO por
  // finalidade (USP-043 #37). Criado via SQL em migration (não expressável aqui).
  @@map("consents")
}

// ── Empresas (USP-012 — ADR-0015) ────────────────────────────────────────────
// Empresa cadastrada pela Pessoa-responsável. CNPJ único e normalizado (somente
// dígitos). isVerified=false até aprovação da primeira vaga (USP-017).
// PersonCompanyGrant vincula Pessoa↔Empresa com tipo RESPONSIBLE; append-only
// (revogação via revokedAt, nunca delete).

/// Tipo jurídico da Empresa (CNPJ regular = LTDA/SA/etc.; MEI = Microempreendedor).
enum CompanyType {
  CNPJ_REGULAR
  MEI

  @@map("company_type")
}

/// Tipo do vínculo Pessoa↔Empresa.
enum CompanyGrantType {
  RESPONSIBLE

  @@map("company_grant_type")
}

/// Empresa cadastrada no portal (ADR-0015).
/// CNPJ armazenado apenas com dígitos (normalizado antes de persistir).
model Company {
  id           String      @id @default(uuid()) @db.Uuid
  cnpj         String      @unique
  type         CompanyType @default(CNPJ_REGULAR)
  razaoSocial  String      @map("razao_social")
  nomeFantasia String      @map("nome_fantasia")
  setor        String
  descricao    String?
  endereco     String?
  isVerified   Boolean     @default(false) @map("is_verified")
  createdBy    String      @map("created_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  grants PersonCompanyGrant[]

  @@index([cnpj])
  @@map("companies")
}

/// Vínculo Pessoa↔Empresa (append-only). Revogação via revokedAt.
model PersonCompanyGrant {
  id        String           @id @default(uuid()) @db.Uuid
  personId  String           @map("person_id") @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  grantType CompanyGrantType @default(RESPONSIBLE) @map("grant_type")
  grantedBy String           @map("granted_by") @db.Uuid
  grantedAt DateTime         @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedBy String?          @map("revoked_by") @db.Uuid

  person  Person  @relation(fields: [personId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([personId, revokedAt])
  @@index([companyId, grantType, revokedAt])
  @@map("person_company_grants")
}

/// Resultado de uma tentativa de autenticação.
enum AuthOutcome {
  SUCCESS
  FAILURE

  @@map("auth_outcome")
}

/// Tentativas de login para lockout `(email, ip)` 5 falhas em 15 min
/// (ADR-0029). Tabela técnica, separada de `audit_log` (ADR-0023).
/// Retenção parametrizada por `AUTH_ATTEMPTS_RETENTION_DAYS` (default 90 dias).
model AuthAttempt {
  id          String      @id @default(uuid()) @db.Uuid
  /// E-mail normalizado (lowercase + trim) — ver normalização em loginAction.
  email       String
  ip          String
  outcome     AuthOutcome
  attemptedAt DateTime    @default(now()) @map("attempted_at") @db.Timestamptz(6)

  @@index([email, ip, attemptedAt], name: "auth_attempts_lockout_idx")
  @@index([attemptedAt], name: "auth_attempts_retention_idx")
  @@map("auth_attempts")
}

// ── Auditoria (US #12 — ADR-0023 / ADR-T-0004) ────────────────────────────
// Log imutável de toda escrita sensível. Append-only garantido no nível do
// banco por `REVOKE UPDATE, DELETE` (ver migration desta tabela). Catálogo de
// eventos em `@/modules/audit/events`; gravação via `withAudit(...)` na mesma
// transação da operação (ADR-0020 — atomicidade: audit falha => rollback).
// Retenção operacional de 1 ano (job mensal de purge — scripts/purge-audit-log.ts).

/// Registro de auditoria append-only (technical-design.md §2.9).
/// `id` é BIGSERIAL para volume contínuo sem colisão de UUID.
model AuditLog {
  id            BigInt   @id @default(autoincrement())
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Ator no plano de autenticação (Supabase Auth user). Nullable em eventos
  /// sem ator (ex.: cron de expiração/purge) ou falha de login com e-mail desconhecido.
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  /// Ator no plano de domínio (Pessoa). Nullable pelos mesmos motivos.
  actorPersonId String?  @map("actor_person_id") @db.Uuid
  /// Tipo do evento — vem do catálogo `@/modules/audit/events` (string solta proibida).
  action        String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  /// Estado anterior (UPDATE/DELETE) — nulo em INSERT. Nunca inclui senhas/tokens/CV cru.
  before        Json?
  /// Estado posterior (INSERT/UPDATE) — nulo em DELETE.
  after         Json?
  /// Contexto da request: requestId, rota, origem etc. (sem PII).
  context       Json?
  ip            String?  @db.Inet
  userAgent     String?  @map("user_agent")
  /// Obrigatória (validada na app) em revogação/rejeição/edição retroativa.
  justification String?

  @@index([entityType, entityId])
  @@index([actorPersonId, occurredAt])
  @@index([action, occurredAt])
  @@index([occurredAt], name: "audit_log_retention_idx")
  @@map("audit_log")
}
